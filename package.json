{
  "name": "it-scool",
  "version": "1.0.0",
  "description": "Обучающая платформа IT-курсов для школьников",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "seed": "node server/seed.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:vite": "node client/node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "start": "node server/index.js",
    "setup": "npm run install:all && npm run seed && npm run build",
    "pack": "node scripts/pack-release.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
